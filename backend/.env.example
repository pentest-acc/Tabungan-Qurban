# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/tabungan_qurban_db

# JWT
JWT_SECRET=ganti-dengan-secret-rahasia-anda
JWT_EXPIRES_IN=7d

# Cloudinary (untuk upload bukti pembayaran — opsional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# CORS
CLIENT_URL=http://localhost:5173

# Payment Gateway (sandbox bawaan; ganti dengan server key provider asli)
PAYMENT_SERVER_KEY=sandbox-server-key
PAYMENT_EXPIRY_MINUTES=30

# WhatsApp gateway (opsional — kosong = mode simulasi, pesan dicatat di log)
# Isi dengan token provider, contoh: Fonnte (https://fonnte.com)
WHATSAPP_API_TOKEN=

# Email "Lapor Developer" (opsional — kosong = mode simulasi, laporan tetap
# tersimpan di DB & dicatat di log). Contoh Gmail App Password:
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=emailku@gmail.com  SMTP_PASS=app-password-16-digit
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Email tujuan laporan (default = email developer)
LAPORAN_EMAIL=stephenbaldwin2005s@gmail.com
